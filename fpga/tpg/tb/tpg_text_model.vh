// Label text: sel 0 = pattern name, 1 = timing line. Returns the string
// right-aligned in 40 bytes (Verilog string rules) and its length.
function integer tm_len(input integer pat, input integer sel);
  reg [8*40-1:0] s;
  integer n;
  begin
    s = tm_text(pat, sel);
    n = 0;
    while (n < 40 && s[n * 8 +: 8] != 8'h00) n = n + 1;
    tm_len = n;
  end
endfunction

function [8*40-1:0] tm_text(input integer pat, input integer sel);
  reg [8*40-1:0] s;
  begin
    s = 0;
    if (sel == 1) s = "15.73 KHZ  60.05 HZ";
    else case (pat)
      0: s = "COLOR BARS";
      1: s = "RGB GRADIENT";
      2: s = "B&W GRADIENT";
      3: s = "CHECKERBOARD";
      4: s = "CROSSHATCH+DOTS";
      5: s = "RGB CROSSHATCH";
      6: s = "SOLID RED";
      7: s = "SOLID BLUE";
      8: s = "SOLID GREEN";
      9: s = "FOCUS (H)";
      default: s = 0;
    endcase
    tm_text = s;
  end
endfunction

// The i-th character (0 = leftmost) of a label.
function integer tm_char(input integer pat, input integer sel, input integer i);
  reg [8*40-1:0] s;
  integer n;
  begin
    s = tm_text(pat, sel);
    n = tm_len(pat, sel);
    tm_char = s[(n - 1 - i) * 8 +: 8];
  end
endfunction
